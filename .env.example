# Copy this file to .env and fill in your keys.
# .env is gitignored — never commit real keys.

# ChangeNow swap API key — https://changenow.io/api
CHANGENOW_API_KEY=

# Stripe secret key — https://dashboard.stripe.com/apikeys
# Use sk_test_... for testing, sk_live_... for production
STRIPE_SECRET_KEY=

# Anthropic API key for Ego AI — https://console.anthropic.com
EGO_AI_KEY=

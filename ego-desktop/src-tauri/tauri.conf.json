{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist",
    "withGlobalTauri": false
  },
  "package": {
    "productName": "Ego Desktop",
    "version": "0.3.31"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "window": {
        "all": false,
        "close": true,
        "hide": true,
        "show": true,
        "maximize": true,
        "minimize": true,
        "unmaximize": true,
        "unminimize": true,
        "startDragging": true
      },
      "fs": {
        "all": true,
        "scope": ["**"]
      },
      "dialog": {
        "all": false,
        "open": true,
        "save": true,
        "message": true,
        "ask": true,
        "confirm": true
      },
      "clipboard": {
        "all": false,
        "readText": true,
        "writeText": true
      },
      "notification": {
        "all": true
      },
      "globalShortcut": {
        "all": false
      },
      "os": {
        "all": true
      },
      "path": {
        "all": true
      },
      "http": {
        "all": false,
        "request": true,
        "scope": [
          "http://EgoRelay.egoblockchain.com:8080/**",
          "https://api.coingecko.com/**"
        ]
      },
      "process": {
        "all": false,
        "relaunch": true,
        "exit": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.ego.desktop",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico",
        "icons/icon.png"
      ],
      "resources": {
        "icons/ego_square.png": "icons/",
        "runtime/vcruntime140.dll": "",
        "runtime/vcruntime140_1.dll": "",
        "runtime/msvcp140.dll": "",
        "runtime/msvcp140_1.dll": "",
        "runtime/msvcp140_2.dll": "",
        "runtime/concrt140.dll": "",
        "runtime/mfc140.dll": "",
        "runtime/mfc140u.dll": ""
      },
      "externalBin": [],
      "copyright": "",
      "category": "DeveloperTool",
      "shortDescription": "Quantum-Safe Blockchain Desktop App",
      "longDescription": "Ego Desktop - Experience quantum-safe blockchain technology with secure key generation, feeless transactions, encrypted file sharing, and blockchain earnings.",
      "deb": {
        "depends": []
      },
      "macOS": {
        "frameworks": [],
        "minimumSystemVersion": "10.13",
        "exceptionDomain": "",
        "signingIdentity": null,
        "entitlements": null
      },
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": "",
        "tsp": false,
        "wix": {
          "language": "en-US",
          "bannerPath": "installer/banner.bmp",
          "dialogImagePath": "installer/dialog.bmp"
        },
        "nsis": {
          "languages": ["English"],
          "displayLanguageSelector": false
        }
      }
    },
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:* ws://localhost:* http://EgoRelay.egoblockchain.com:8080 ws://EgoRelay.egoblockchain.com:8080 https://api.coingecko.com; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' http://localhost:*; img-src 'self' data: blob: http://localhost:* https://assets.coingecko.com https://coin-images.coingecko.com; frame-src http://localhost:*"
    },
    "updater": {
      "active": false
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "Ego Desktop",
        "width": 1200,
        "height": 805,
        "minWidth": 900,
        "minHeight": 605,
        "center": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false
      }
    ],
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    }
  }
}